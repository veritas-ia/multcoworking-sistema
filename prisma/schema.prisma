// =============================================================================
// Banco de dados do Sistema de Reservas.
// Regras de negocio: ver CLAUDE.md (fonte da verdade).
//
// Convencoes deste schema:
//  - Todo instante no tempo e timestamptz (guarda em UTC, mostra em Sao Paulo).
//  - Horario de funcionamento e "hora de relogio" local, guardada como texto "HH:MM".
//  - Nomes em portugues; colunas do banco em minusculo_com_underline.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Listas fechadas de valores
// -----------------------------------------------------------------------------

enum StatusReserva {
  CONFIRMADA
  REAGENDADA
  CANCELADA
  CONCLUIDA
}

enum OrigemReserva {
  PUBLICO
  ADMIN
}

/// Em que area o cliente trabalha. Perguntado na reserva, usado so no
/// relatorio do painel — nao muda preco nem disponibilidade.
/// Como a reserva foi vendida.
enum CategoriaReserva {
  /// Por hora, na grade de 30 min. E o padrao desde sempre.
  HORA
  /// Dia inteiro, num horario fixo e por um preco fechado.
  DIARIA
}

enum StatusMensagem {
  ENVIADA
  FALHOU
}

/// As sete mensagens de WhatsApp do sistema.
enum ChaveTemplate {
  codigo_verificacao
  reserva_confirmada
  /// Confirmacao de uma SERIE inteira, numa mensagem so (Fase 9).
  /// Sem ela, uma serie de dois meses mandaria ~17 mensagens seguidas.
  serie_confirmada
  reserva_cancelada
  reserva_reagendada
  lembrete_13h
  lembrete_3h
  /// Agradecimento + convite para avaliar, 1 hora DEPOIS do termino.
  avaliacao_pos_uso
  /// Confirmacao de VARIAS reservas feitas na mesma sentada, numa mensagem
  /// so, com a quantidade e o valor somado. Quem faz uma reserva unica
  /// continua recebendo "reserva_confirmada".
  reservas_confirmadas
  /// O demonstrativo mensal, com o PDF em anexo. Variaveis: {{nome}},
  /// {{periodo}}, {{horas}} e {{valor}}.
  demonstrativo_mensal
  /// A equipe esticou o termino porque o cliente ficou mais tempo.
  reserva_estendida
}

/// De quanto em quanto tempo uma serie se repete (Fase 9).
/// A base e SEMPRE dia da semana, nunca dia do numero do mes.
enum FrequenciaRecorrencia {
  /// Toda semana, nos dias escolhidos.
  SEMANAL
  /// A cada duas semanas, contadas a partir da data de inicio.
  QUINZENAL
  /// Uma vez por mes: "a primeira terca", "a ultima sexta"...
  MENSAL
}

/// Usado apenas na tabela tecnica de ocupacao.
/// O que foi feito. Cada valor e uma acao que MUDA o significado de um
/// registro ou o destroi — nao e um registro de tudo que acontece no sistema.
enum TipoDeAcao {
  /// A reserva deixou de existir. O unico caso em que o registro aqui e a
  /// UNICA prova de que ela existiu.
  RESERVA_EXCLUIDA
  /// A equipe mudou o status na mao (concluida, reaberta, descancelada).
  RESERVA_STATUS_ALTERADO
}

enum TipoOcupacao {
  RESERVA
  BLOQUEIO
}

// -----------------------------------------------------------------------------
// Cadastros
// -----------------------------------------------------------------------------

model Sala {
  id                   String  @id @default(uuid(7))
  nome                 String  @unique
  slug                 String  @unique
  ativa                Boolean @default(true)
  capacidade           Int?
  /// Preco por hora DE DIA (ate o inicio da faixa noturna), em reais.
  /// Usado so para calcular o valor estimado — nao ha pagamento online.
  precoPorHora         Decimal @map("preco_por_hora") @db.Decimal(10, 2)
  /// Preco por hora APOS o inicio da faixa noturna.
  precoPorHoraNoturno  Decimal @map("preco_por_hora_noturno") @db.Decimal(10, 2)
  /// Preco por hora DE DIA quando o grupo passa de "pessoasParaGrupo".
  /// Nulo = esta sala nao cobra diferente por tamanho de grupo durante o dia.
  precoPorHoraGrupo    Decimal? @map("preco_por_hora_grupo") @db.Decimal(10, 2)
  /// Preco por hora a noite quando o grupo passa de "pessoasParaGrupo".
  /// Nulo = esta sala nao cobra diferente por tamanho de grupo.
  precoPorHoraNoturnoGrupo Decimal? @map("preco_por_hora_noturno_grupo") @db.Decimal(10, 2)
  /// A partir de QUANTAS pessoas o preco de grupo POR HORA passa a valer
  /// (acima deste numero). Vale para o preco de dia e o de noite.
  pessoasParaGrupo     Int?    @map("pessoas_para_grupo")
  /// Esta sala aceita reserva na categoria DIARIA?
  aceitaDiaria         Boolean @default(false) @map("aceita_diaria")
  /// Preco fechado da diaria. Nulo quando a sala nao aceita diaria.
  precoDiaria          Decimal? @map("preco_diaria") @db.Decimal(10, 2)
  /// Preco da diaria para grupo grande. Nulo = diaria de valor unico.
  precoDiariaGrupo     Decimal? @map("preco_diaria_grupo") @db.Decimal(10, 2)
  /// ACIMA de quantas pessoas vale o preco de diaria de grupo.
  ///
  /// E um numero PROPRIO, e nao "pessoasParaGrupo" reaproveitado: na Sala de
  /// Reuniao o pulo por hora e entre 4 e 5 pessoas, e o da diaria e entre 5 e
  /// 6. Unificar faria a diaria de 5 pessoas sair pelo preco de grupo.
  pessoasParaGrupoDiaria Int?  @map("pessoas_para_grupo_diaria")
  /// Duracao maxima de uma reserva, em minutos. Nulo = ate o fechamento do dia.
  duracaoMaximaMinutos Int?    @map("duracao_maxima_minutos")
  /// Ordem de exibicao na tela.
  ordem                Int
  /// Cor da sala na agenda do painel, em "#RRGGBB". Escolhida no cadastro,
  /// de uma paleta fechada — cor livre acabaria em texto ilegivel.
  cor                  String  @default("#FFC700") @db.VarChar(7)

  criadoEm    DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  fotos       FotoDaSala[]
  reservas    Reserva[]
  bloqueios   Bloqueio[]
  recorrencias Recorrencia[]
  ocupacoes   OcupacaoSala[]

  @@map("salas")
}

/// Fotos da sala, mostradas ao cliente antes de reservar (carrossel).
///
/// Os arquivos ficam no Cloudinary; aqui guardamos so a referencia. O
/// "publicId" e o que permite apagar de la depois — sem ele, remover a foto
/// do site deixaria o arquivo orfao para sempre.
model FotoDaSala {
  id     String @id @default(uuid(7))
  salaId String @map("sala_id")
  sala   Sala   @relation(fields: [salaId], references: [id], onDelete: Cascade)

  /// Identificador no Cloudinary. E por ele que se apaga o arquivo de la.
  publicId String @map("public_id")
  /// Endereco da imagem, como o Cloudinary devolveu.
  url      String
  /// Ordem no carrossel. 1 aparece primeiro.
  ordem    Int

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([salaId, ordem])
  @@map("fotos_sala")
}

model HorarioFuncionamento {
  id String @id @default(uuid(7))
  /// 0 = domingo, 1 = segunda ... 6 = sabado.
  diaDaSemana    Int     @unique @map("dia_da_semana")
  aberto         Boolean
  /// "HH:MM" no fuso de Sao Paulo. Nulo quando o dia e fechado.
  horaAbertura   String? @map("hora_abertura") @db.VarChar(5)
  horaFechamento String? @map("hora_fechamento") @db.VarChar(5)

  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("horarios_funcionamento")
}

model Usuario {
  id String @id @default(uuid(7))
  nome String
  /// Nome de login do painel. Sem e-mail no MVP (decisao do CLAUDE.md).
  usuario   String @unique
  senhaHash String @map("senha_hash")
  /// Desligado nao entra mais no painel, mas continua aparecendo como autor
  /// dos bloqueios e feriados que criou (Fase 11).
  ativo     Boolean @default(true)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  bloqueiosCriados    Bloqueio[]
  recorrenciasCriadas Recorrencia[]
  telefonesDeBalcao   TelefoneDeBalcao[]
  acoesRegistradas    AcaoRegistrada[]

  @@map("usuarios")
}

/// Tentativas de login no painel, para travar ataque de forca bruta (Fase 7).
/// Guardadas no banco, e nao na memoria, para o limite sobreviver a um
/// reinicio do servidor.
model TentativaLogin {
  id String @id @default(uuid(7))
  /// Nome de usuario TENTADO. Pode nem existir — e isso que se quer medir.
  usuario String
  /// Endereco de rede de quem tentou, para o limite por IP.
  ip      String?
  sucesso Boolean

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([usuario, criadoEm])
  @@index([ip, criadoEm])
  @@map("tentativas_login")
}

/// Uma empresa que aluga sala, com varios funcionarios reservando.
///
/// Existe porque o relatorio por CLIENTE nao bastava: a Prestare aparece em
/// tres telefones diferentes, e as vezes quem paga a conta do mes e a empresa.
/// A area de atuacao do cliente, perguntada na reserva.
///
/// Virou tabela em 27/10/2026 para a equipe poder editar a lista no painel.
/// Antes era um tipo fixo do PostgreSQL, que nao da para mexer por tela.
///
/// Nao entra em preco, disponibilidade nem em regra nenhuma da agenda: serve
/// ao relatorio — com UMA excecao, o bloqueio abaixo.
model Profissao {
  id String @id @default(uuid(7))

  /// O nome interno, que NUNCA muda depois de criado. Renomear mexe em "nome".
  slug String @unique
  nome String @unique

  /// Desligada some do site, da recepcao e da serie. Continua no relatorio:
  /// o historico de quem ja escolheu nao pode sumir.
  ativa Boolean @default(true)

  /// NAO PODE RESERVAR. Diferente de desligada: continua visivel na lista, e
  /// a recusa explica o motivo. Hoje e o caso do Juridico, por contrato de
  /// exclusividade com uma empresa de advocacia.
  bloqueada Boolean @default(false)

  /// O texto mostrado quando bloqueada. Fica aqui, e nao no codigo, porque o
  /// texto de hoje fala em "area juridica" — bloquear outra area amanha com a
  /// mesma frase seria mentira. Nulo usa o aviso generico.
  avisoBloqueio String? @map("aviso_bloqueio")

  ordem Int @default(0)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  reservas Reserva[]

  @@map("profissoes")
}

model Empresa {
  id    String  @id @default(uuid(7))
  nome  String  @unique
  /// Desligada some dos relatorios, mas o vinculo continua: empresa que saiu
  /// do coworking ainda precisa aparecer no historico.
  ativa Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  telefones      TelefoneDaEmpresa[]
  reservas       Reserva[]
  clientes       Cliente[]
  demonstrativos Demonstrativo[]

  @@map("empresas")
}

/// Qual telefone pertence a qual empresa.
///
/// O TELEFONE E A CHAVE, e nao um id proprio: assim o banco impede sozinho o
/// mesmo numero somar em duas empresas e inflar o relatorio das duas.
///
/// O vinculo e do TELEFONE, nunca da reserva. O relatorio descobre a empresa
/// na hora de montar, entao marcar um numero junta as reservas passadas dele
/// na hora — e desvincular tira.
model TelefoneDaEmpresa {
  telefone  String  @id
  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([empresaId])
  @@map("telefones_empresa")
}

/// O CLIENTE, como cadastro de verdade (Fase 14).
///
/// Ate aqui "quem e o cliente" era adivinhado de dois campos soltos que a
/// recepcao digitava em cada reserva: o nome e o telefone. Dai vinham os 44
/// nomes para 25 telefones, o mesmo Rafael em dois numeros e o telefone da
/// casa virando "cliente" com 28 horas.
///
/// O nome daqui e o OFICIAL, mostrado no relatorio. O nome escrito em cada
/// reserva continua la, intocado: ele e a verdade daquele dia e e o que a
/// agenda mostra.
model Cliente {
  id   String  @id @default(uuid(7))
  nome String
  /// Desligado some das telas de escolha; o historico fica inteiro, mesma
  /// regra das salas, das empresas e das areas de atuacao. Excluir nao existe.
  ativo Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  /// A EMPRESA em que esta pessoa trabalha.
  ///
  /// O cadastro de cliente e de PESSOA: o Matheus e o Vinicius sao dois, e
  /// juntar os dois seria dizer que sao a mesma pessoa. Quem junta gente da
  /// mesma empresa e este campo.
  ///
  /// Fica no CLIENTE, e nao no telefone (como era ate 11/11/2026), por dois
  /// motivos: o vinculo por telefone nao alcanca quem nasceu do telefone do
  /// balcao e nao tem numero proprio, e a equipe pensa em "o Matheus e da
  /// Toca", nao em "este numero e da Toca".
  ///
  /// Nulo e normal: e quem nao e de empresa nenhuma.
  empresaId String?  @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  /// Preco por hora COMBINADO com este cliente, quando ha um.
  ///
  /// A Toca paga R$ 30 na sala que custa R$ 40 na tabela. O valor congelado
  /// em cada reserva e o da tabela, entao ele nao serve para o demonstrativo
  /// do mensalista — este campo e que vale ali. Nulo = usa o que a gestao
  /// digitar na hora.
  precoHoraAcordado Decimal? @map("preco_hora_acordado") @db.Decimal(10, 2)

  telefones      TelefoneDoCliente[]
  reservas       Reserva[]
  demonstrativos Demonstrativo[]

  @@index([nome])
  @@index([empresaId])
  @@map("clientes")
}

/// Qual telefone pertence a qual cliente.
///
/// O TELEFONE E A CHAVE, e nao um id proprio — mesmo desenho de
/// "telefones_empresa". E o banco impedindo sozinho que um numero pertenca a
/// duas pessoas e o faturamento apareca dobrado, sem ninguem desconfiar.
///
/// Um cliente pode ter VARIOS telefones: e assim que o Rafael dos dois
/// numeros vira uma pessoa so.
///
/// Telefone de BALCAO nunca entra aqui: ele nao e de ninguem.
model TelefoneDoCliente {
  telefone  String  @id
  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([clienteId])
  @@map("telefones_cliente")
}

/// Telefones que NAO sao de um cliente: o do balcao, o do atendimento
/// comercial, um celular de teste.
///
/// POR QUE ISTO EXISTE. O relatorio agrupa cliente pelo TELEFONE, e para 24
/// dos 25 numeros isso esta certo. O do atendimento comercial do coworking,
/// nao: a recepcao lanca nele a reserva de quem nao deixou o proprio numero,
/// e ele acumulou 14 reservas de QUATRO clientes diferentes. No painel aquilo
/// virava um "cliente" so, com 28 horas, levando o nome de um deles.
///
/// Marcado aqui, o relatorio passa a agrupar as reservas desse numero pelo
/// NOME de cada uma. Nao e adivinhacao: a equipe marca, porque so ela sabe
/// qual numero e da casa.
///
/// O TELEFONE E A CHAVE, e nao um id proprio: o mesmo numero nao pode ser
/// marcado duas vezes. Desmarcar devolve tudo como era — nenhuma reserva e
/// tocada, nem na marcacao nem na remocao.
model TelefoneDeBalcao {
  telefone String @id

  /// Por que foi marcado, escrito pela equipe. Aparece no painel para a
  /// proxima pessoa entender a marcacao sem precisar perguntar.
  motivo String

  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  /// Quem marcou. Nulo quando o usuario foi desligado depois.
  criadoPorId String? @map("criado_por_id")
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  @@map("telefones_balcao")
}

/// O DEMONSTRATIVO MENSAL de um cliente.
///
/// A gestao fazia isto numa planilha, a mao. A planilha de setembro da Toca
/// nao tinha UMA formula: o "52 horas" e o "R$ 3.033,66" eram texto digitado,
/// e os dois estavam errados — a soma das linhas dava 50 h e R$ 3.023,66.
/// Foram R$ 70 cobrados a mais, e ninguem tinha como perceber.
///
/// TUDO FICA CONGELADO AQUI. A tabela de horas vem das reservas no momento da
/// emissao e e gravada como estava: se alguem remarcar uma reserva depois, o
/// documento que o cliente recebeu continua batendo com o que foi enviado.
/// Mesma regra do valor congelado na reserva.
model Demonstrativo {
  id String @id @default(uuid(7))

  /// UM DOS DOIS. O documento e de uma PESSOA ou de uma EMPRESA inteira — o
  /// da Toca cobre o Matheus, o Vinicius e todo mundo que reservou no nome
  /// dela. Um documento por pessoa obrigaria a gestao a somar quatro a mao.
  clienteId String?  @map("cliente_id")
  cliente   Cliente? @relation(fields: [clienteId], references: [id])
  empresaId String?  @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  /// O periodo coberto. NAO e mes fechado: o ciclo da Toca vai de 10/09 a
  /// 10/10, e o anterior ia de 12/08 a 10/09.
  de  DateTime @db.Date
  ate DateTime @db.Date

  /// Preco por hora COMBINADO com o cliente, congelado na emissao.
  ///
  /// NULO e o caminho normal: sem preco negociado, cada reserva vale o valor
  /// que ela ja tem gravado, e esse valor viaja dentro de "itens". Preenchido
  /// so para quem paga um preco diferente da tabela da sala — a Toca paga
  /// R$ 30 numa sala de R$ 40.
  valorHora Decimal? @map("valor_hora") @db.Decimal(10, 2)
  /// Total de horas do periodo, somado pelo sistema.
  horas     Decimal @db.Decimal(10, 2)

  /// A tabela de horas, como estava na emissao. Guarda tambem QUEM reservou,
  /// porque num documento de empresa o cliente quer saber de quem foram as
  /// horas que estao sendo cobradas dele:
  /// [{ "dia": "2026-09-11", "sala": "Sala Privativa", "horas": 2.5,
  ///    "pessoa": "Matheus Vitullo" }]
  itens Json

  /// As linhas que a gestao acrescenta a mao — posicoes, emporio, impressoes:
  /// [{ "descricao": "2 posicoes", "valor": "940.00" }]
  linhasExtras Json @map("linhas_extras")

  /// Total escrito a mao, quando houve renegociacao. NULO e o normal: vale a
  /// soma que o sistema faz. Existe porque o dono pediu a saida de emergencia,
  /// avisando que e raro — e por isso ele aparece destacado na tela.
  totalAjustado Decimal? @map("total_ajustado") @db.Decimal(10, 2)

  /// Quando foi mandado pelo WhatsApp. Nulo = ainda nao foi.
  enviadoEm DateTime? @map("enviado_em") @db.Timestamptz(3)

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@index([clienteId, de])
  @@index([empresaId, de])
  @@map("demonstrativos")
}

/// Parametros gerais do sistema, editaveis no painel (Fase 11).
model Configuracao {
  chave String @id
  valor String
  /// Explicacao curta, mostrada no painel.
  descricao String

  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("configuracoes")
}

// -----------------------------------------------------------------------------
// Agenda
// -----------------------------------------------------------------------------

model Reserva {
  id     String @id @default(uuid(7))
  salaId String @map("sala_id")
  sala   Sala   @relation(fields: [salaId], references: [id])

  nomeCliente String @map("nome_cliente")
  /// Formato internacional E.164: +55 + DDD + celular de 9 digitos.
  telefone    String
  /// Quantas pessoas vao usar a sala. So e perguntado nas salas que cobram
  /// diferente por tamanho de grupo; nas outras fica nulo.
  pessoas     Int?

  inicio         DateTime @db.Timestamptz(3)
  fim            DateTime @db.Timestamptz(3)
  duracaoMinutos Int      @map("duracao_minutos")
  /// Valor estimado, congelado no momento da criacao da reserva.
  valor          Decimal  @db.Decimal(10, 2)

  status    StatusReserva    @default(CONFIRMADA)
  origem    OrigemReserva
  /// Por hora ou dia inteiro. Muda o preco e o horario ocupado.
  categoria CategoriaReserva @default(HORA)
  /// Area de atuacao do cliente. NULO nas reservas anteriores ao campo — o
  /// relatorio trata essas como "nao informado". Para reserva NOVA e
  /// obrigatorio, e quem cobra isso e a aplicacao: a coluna precisa aceitar
  /// nulo por causa do passado.
  profissaoId String?    @map("profissao_id")
  profissao   Profissao? @relation(fields: [profissaoId], references: [id])

  /// A empresa que esta reserva pertence, respondida por quem reservou.
  ///
  /// Fica NA RESERVA, e nao no telefone, por dois motivos: a reserva antiga nao
  /// muda de dono porque a pessoa trocou de empresa depois, e cada reserva
  /// carrega a propria resposta, sem conflito entre o que a equipe marcou e o
  /// que o cliente disse.
  ///
  /// Nulo e normal: e a reserva de quem nao e de empresa mensalista, e e
  /// tambem a reserva antiga, criada antes de a pergunta existir. Para essas,
  /// o relatorio cai no vinculo do telefone (TelefoneDaEmpresa).
  empresaId String?  @map("empresa_id")
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  /// QUEM e o cliente desta reserva (Fase 14).
  ///
  /// OBRIGATORIO desde 10/11/2026: quem garante que nenhuma reserva fica sem
  /// dono e o BANCO, e nao a aplicacao. O nome e o telefone continuam
  /// gravados na linha de proposito — eles sao a verdade daquele dia, e e o
  /// que a agenda mostra.
  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  recorrenciaId String?      @map("recorrencia_id")
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  /// Lembretes: 13 horas antes e 3 horas antes (decisao do dono na Fase 10).
  ///
  /// Tres estados por lembrete:
  ///   data preenchida        -> ja foi enviado
  ///   nulo + naoAplicavel    -> nunca vai sair (o horario ja tinha passado)
  ///   nulo + nao aplicavel false -> ainda vai sair
  lembrete13hEnviadoEm DateTime? @map("lembrete_13h_enviado_em") @db.Timestamptz(3)
  lembrete3hEnviadoEm  DateTime? @map("lembrete_3h_enviado_em") @db.Timestamptz(3)
  lembrete13hNaoAplicavel Boolean @default(false) @map("lembrete_13h_nao_aplicavel")
  lembrete3hNaoAplicavel  Boolean @default(false) @map("lembrete_3h_nao_aplicavel")

  /// Quando a confirmacao desta reserva foi tratada.
  ///
  /// Nulo = ainda esta na janela de agrupamento, esperando para ver se o
  /// cliente vai marcar mais alguma antes de a mensagem sair. Ver a rotina
  /// "confirmacoesAgrupadas".
  confirmacaoEnviadaEm DateTime? @map("confirmacao_enviada_em") @db.Timestamptz(3)

  /// Convite para avaliar, 1 hora DEPOIS do termino. Mesma mecanica dos
  /// lembretes: data preenchida = ja foi; "nao aplicavel" = nunca vai sair
  /// (a reserva terminou ha tempo demais quando o sistema viu).
  avaliacaoEnviadaEm   DateTime? @map("avaliacao_enviada_em") @db.Timestamptz(3)
  avaliacaoNaoAplicavel Boolean  @default(false) @map("avaliacao_nao_aplicavel")

  /// Lista de alteracoes da reserva (reagendamentos, cancelamento).
  historicoAlteracoes Json @default("[]") @map("historico_alteracoes")

  criadoEm     DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  canceladoEm  DateTime? @map("cancelado_em") @db.Timestamptz(3)

  mensagens LogMensagem[]

  @@index([salaId, inicio])
  @@index([telefone, status])
  @@index([recorrenciaId])
  @@index([confirmacaoEnviadaEm])
  @@index([clienteId])
  @@map("reservas")
}

model Bloqueio {
  id     String @id @default(uuid(7))
  salaId String @map("sala_id")
  sala   Sala   @relation(fields: [salaId], references: [id])

  inicio DateTime @db.Timestamptz(3)
  fim    DateTime @db.Timestamptz(3)
  /// Motivo interno. NUNCA aparece em endpoint publico.
  motivo String?

  /// Bloqueios criados juntos (ex.: um feriado em todas as salas) compartilham
  /// este identificador, para poderem ser removidos de uma vez so.
  grupoId String? @map("grupo_id")

  criadoPorId String?  @map("criado_por_id")
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([salaId, inicio])
  @@index([criadoPorId])
  @@index([grupoId])
  @@map("bloqueios")
}

/// Reserva que se repete toda semana. As regras entram na Fase 9.
model Recorrencia {
  id     String @id @default(uuid(7))
  salaId String @map("sala_id")
  sala   Sala   @relation(fields: [salaId], references: [id])

  nomeCliente String @map("nome_cliente")
  telefone    String

  /// Um ou mais dias da semana: 0 = domingo ... 6 = sabado.
  /// Uma serie pode ser "terca E quarta" — dai ser lista, e nao um numero so.
  diasDaSemana Int[]  @map("dias_da_semana")
  /// "HH:MM" no fuso de Sao Paulo.
  horaInicio   String @map("hora_inicio") @db.VarChar(5)
  horaFim      String @map("hora_fim") @db.VarChar(5)

  frequencia FrequenciaRecorrencia
  /// So na frequencia MENSAL: 1, 2, 3 = primeira/segunda/terceira do mes;
  /// -1 = ultima. Nulo nas outras frequencias.
  semanaDoMes Int? @map("semana_do_mes")

  dataInicio DateTime @map("data_inicio") @db.Date
  /// Obrigatoria: toda serie tem fim (decisao da Fase 9).
  dataFim    DateTime @map("data_fim") @db.Date
  ativa      Boolean  @default(true)

  criadoPorId String?  @map("criado_por_id")
  criadoPor   Usuario? @relation(fields: [criadoPorId], references: [id], onDelete: SetNull)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  reservas Reserva[]

  @@index([salaId])
  @@index([criadoPorId])
  @@map("recorrencias")
}

// -----------------------------------------------------------------------------
// Identificacao do cliente por WhatsApp
// -----------------------------------------------------------------------------

model CodigoVerificacao {
  id       String @id @default(uuid(7))
  telefone String
  /// Nunca guardamos o codigo em texto puro, so o embaralhado.
  codigoHash String @map("codigo_hash")

  expiraEm   DateTime  @map("expira_em") @db.Timestamptz(3)
  tentativas Int       @default(0)
  usadoEm    DateTime? @map("usado_em") @db.Timestamptz(3)
  criadoEm   DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  /// Endereco de rede de quem pediu o codigo, para o limite por IP.
  ip         String?

  @@index([telefone, criadoEm])
  @@index([ip, criadoEm])
  @@map("codigos_verificacao")
}

model SessaoCliente {
  id       String @id @default(uuid(7))
  telefone String
  /// Embaralhado (SHA-256) do valor que vai no cookie httpOnly.
  /// O valor puro so existe no navegador do cliente; o banco nunca o ve.
  tokenHash String @unique @map("token_hash")

  expiraEm DateTime @map("expira_em") @db.Timestamptz(3)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([telefone])
  @@map("sessoes_cliente")
}

// -----------------------------------------------------------------------------
// Mensagens de WhatsApp
// -----------------------------------------------------------------------------

model TemplateMensagem {
  id    String        @id @default(uuid(7))
  chave ChaveTemplate @unique
  /// Texto com variaveis: {{nome}} {{sala}} {{data}} {{inicio}} {{fim}} {{valor}} {{codigo}}
  texto String
  /// Explicacao curta, mostrada no painel.
  descricao String

  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  @@map("templates_mensagem")
}

model LogMensagem {
  id        String   @id @default(uuid(7))
  reservaId String?  @map("reserva_id")
  reserva   Reserva? @relation(fields: [reservaId], references: [id], onDelete: SetNull)

  telefone String
  tipo     ChaveTemplate
  status   StatusMensagem
  /// Mensagem de erro devolvida pela Evolution API, quando falhou.
  erro     String?
  tentativas Int @default(1)

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([reservaId])
  @@index([telefone, criadoEm])
  @@map("logs_mensagem")
}

// -----------------------------------------------------------------------------
// Tabela tecnica: e AQUI que o banco impede sobreposicao de horarios.
//
// Nao e escrita pela aplicacao. Gatilhos (triggers) do proprio banco copiam
// para ca cada reserva ativa e cada bloqueio. As travas vivem nesta tabela:
//   1. periodo                -> nenhuma sobreposicao na mesma sala.
//   2. periodo_com_intervalo  -> 30 min de folga entre duas RESERVAS.
// Ver a migracao "travas_de_horario".
// -----------------------------------------------------------------------------

model OcupacaoSala {
  /// Id da reserva ou do bloqueio que originou esta linha.
  origemId String       @id @map("origem_id")
  tipo     TipoOcupacao
  salaId   String       @map("sala_id")
  sala     Sala         @relation(fields: [salaId], references: [id], onDelete: Cascade)

  /// Intervalo real ocupado. Meio aberto: [inicio, fim).
  periodo             Unsupported("tstzrange")
  /// Mesmo intervalo esticado com o tempo de folga, so usado para reservas.
  periodoComIntervalo Unsupported("tstzrange") @map("periodo_com_intervalo")

  @@index([salaId])
  @@map("ocupacao_salas")
}

// -----------------------------------------------------------------------------
// HISTORICO DE ACOES (13/11/2026)
// -----------------------------------------------------------------------------

/// O QUE A EQUIPE FEZ, guardado para sempre.
///
/// POR QUE ISTO EXISTE: passou a ser possivel EXCLUIR uma reserva lancada por
/// engano. Excluir apaga a prova — e a prova e o que permite responder, tres
/// meses depois, "por que o relatorio de outubro mudou?". Pedido do dono:
/// "mesmo que exclua, a gente pelo menos tem esse dado... pelo menos a gente
/// sabe que aconteceu essa ação. Aí sim, é uma evidência."
///
/// ESTE REGISTRO NUNCA SE APAGA. Nao existe rota que o remova, nem a faxina
/// diaria o toca. Um registro de evidencia que pode ser apagado nao e
/// evidencia.
model AcaoRegistrada {
  id   String     @id @default(uuid(7))
  tipo TipoDeAcao

  /// O texto pronto, escrito no momento da acao e nunca recalculado.
  ///
  /// CONGELADO DE PROPOSITO: a reserva excluida nao existe mais para ser
  /// consultada, e o cliente dela pode ter sido desligado depois. Montar a
  /// frase na hora de LER deixaria o historico em branco justamente no caso
  /// que mais importa.
  resumo String

  /// A copia dos dados no momento da acao, para quem precisar do detalhe:
  /// sala, cliente, telefone, dia, horario, valor, status e origem.
  dados Json

  /// Quem fez. Guardamos o NOME junto porque o usuario pode ser desligado, e
  /// a evidencia nao pode virar "alguem fez isso".
  usuarioId   String?  @map("usuario_id")
  usuario     Usuario? @relation(fields: [usuarioId], references: [id])
  usuarioNome String   @map("usuario_nome")

  /// Por que foi feito. Obrigatorio na exclusao — sem motivo, daqui a seis
  /// meses o registro nao explica nada.
  motivo String?

  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([criadoEm])
  @@index([tipo, criadoEm])
  @@map("acoes_registradas")
}
