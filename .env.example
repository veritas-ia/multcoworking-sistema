# =============================================================================
# Copie este arquivo para ".env" e preencha os valores.
#   cp .env.example .env
# O arquivo ".env" NUNCA vai para o Git.
# =============================================================================

# --- Banco de dados (Fase 1) -------------------------------------------------
# Desenvolvimento local: aponta para o Postgres do docker-compose.yml
# (porta 5434 no seu computador, porque a 5432 ja esta ocupada por outro projeto).
DATABASE_URL="postgresql://coworking:coworking_dev@localhost:5434/coworking?schema=public"

# --- Aplicacao (Fase 1) ------------------------------------------------------
# Endereco publico do site, SEM a barra no fim.
#
# E daqui que saem o link dos lembretes de WhatsApp e o cartao que aparece
# quando alguem cola o link no WhatsApp ou no Instagram. Endereco errado aqui
# nao da erro: o cartao simplesmente aparece sem imagem.
#
# Ambiente de teste: https://sistema-mult.veritassdigital.com.br
# No seu computador:  http://localhost:3000
APP_URL="http://localhost:3000"
# Fuso horario do processo. NUNCA mudar: todo o sistema depende disso.
TZ="America/Sao_Paulo"

# --- Usuario admin criado pela carga inicial (Fase 2) ------------------------
# Rode `npm run db:seed` depois de preencher a senha abaixo.
# Sem e-mail: o login do painel e um nome de usuario.
ADMIN_NOME="Administrador"
ADMIN_USUARIO="admin"
# Minimo de 8 caracteres. Se ficar em branco, nenhum admin e criado.
ADMIN_SENHA=""

# --- Login do painel administrativo (Fase 7) ---------------------------------
# Chave secreta que assina o cookie de login do painel. SEM ELA O PAINEL NAO SOBE.
# Precisa ter pelo menos 32 caracteres. Gere a sua com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Em producao use uma chave DIFERENTE da do seu computador. Trocar a chave
# desloga todo mundo do painel na hora — o que e util se vazar.
#
# Nao usamos NextAuth/Auth.js: a sessao do painel e propria, com a mesma
# mecanica da sessao de cliente da Fase 4. Ver AJUSTES-FASE-FINAL.md.
ADMIN_SESSAO_SEGREDO=""

# --- WhatsApp / Evolution API (Fase 4) ---------------------------------------
# ATENCAO AO NOME: tem de ser exatamente EVOLUTION_URL. Escrever
# EVOLUTION_API_URL (ou outro parecido) nao da erro nenhum — o sistema
# simplesmente fica em modo simulado para sempre e nenhuma mensagem sai.
# Endereco da sua instancia da Evolution API.
# DEIXE VAZIO para o MODO SIMULADO: nenhuma mensagem e enviada de verdade,
# o texto aparece no terminal onde o `npm run dev` esta rodando.
EVOLUTION_URL=""
# Chave de autenticacao da Evolution API
EVOLUTION_API_KEY=""
# Nome da instancia (a "conta" de WhatsApp conectada)
EVOLUTION_INSTANCE=""

# --- Rotinas automaticas / node-cron (Fase 10) -------------------------------
# "true" liga os lembretes automaticos. Deixe "false" no seu computador
# para nao disparar mensagens durante o desenvolvimento.
CRON_ATIVO="false"
